# Copie para .env e ajuste. O .env nunca vai para o repositório.
# Banco. SQLite para rodar sem nada instalado; PostgreSQL com o docker-compose.yml (troque a senha):
DATABASE_URL=sqlite:///./aquenda_soa.db
# DATABASE_URL=postgresql+psycopg://aquenda:troque-esta-senha@localhost:5432/aquenda_soa
# Senha do PostgreSQL do docker-compose.yml (a mesma da DATABASE_URL acima).
DB_PASSWORD=troque-esta-senha
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
# Chave das rotas de operador (POST /api/fontes/sincronizar). Vazia fora de desenvolvimento = 503.
CHAVE_OPERADOR=
AMBIENTE=desenvolvimento
