# Exemplo de unidade systemd para a VM (disciplina de Operating Systems).
# Instalar em /etc/systemd/system/aquenda-soa.service
[Unit]
Description=Aquenda SOA (FastAPI: vagas afirmativas e CNES)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aquenda
WorkingDirectory=/opt/aquenda/soa
EnvironmentFile=/etc/aquenda/soa.env
ExecStart=/opt/aquenda/soa/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
